
# commands.py turns raw agent traces into counts of which shell commands the agent ran. generate_new_policy.py uses it as its data layer.

import json, re, shlex
from collections import Counter
from statistics import median
import yaml

RISK = yaml.safe_load(open("./risk.yml"))

PATH = "samples/sample_v2.0_claudecode.jsonl"
THRESH = 0.95

# splits commands that are joint with &&, ||, etc.
SEPS = re.compile(r"&&|\|\||[;|]")
# << 'EOF', <<EOF etc
HEREDOC = re.compile(r"<<-?\s*['\"]?(\w+)['\"]?")
# env variables being declared 
ENV = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")

PREFIX = {"sudo", "env", "nohup", "time", "exec", "command", "xargs"}


def bash_commands(row):
    out = []
    # have to pull from messages but Bash enabled in tools implies that Claude has full access
    for m in row["messages"]:
        for c in m.get("tool_calls") or []:
            name = c.get("name") or c.get("function", {}).get("name")
            # only pulling bash tools
            if name != "Bash":
                continue
            
            # pulls tool name from list and cleans up
            args = c.get("input") or c.get("arguments") or c.get("function", {}).get("arguments")
            if isinstance(args, str):
                try:
                    args = json.loads(args)
                except json.JSONDecodeError:
                    continue
            if isinstance(args, dict) and args.get("command"):
                out.append(args["command"])
    return out

def segments(cmd):
    # checks if there is a HEREDOC marker, if so, ignore the rest of the file
    # suspect if the LLM tries to sneak in commnds into file and then run the file that it wrote
    m = HEREDOC.search(cmd)
    if m:
        cmd = cmd[:m.start()]
    
    # strips seperators
    for part in SEPS.split(cmd):
        part = part.strip().lstrip("(").strip()
        if part and "\n" not in part:
            yield part

def flatten(cmd):
    """Cut heredoc bodies and surface commands nested in $(...) or backticks,
    so `echo $(curl x)` counts curl. Claude Code applies deny/ask rules to
    nested commands too, so the trace analysis should see them."""
    m = HEREDOC.search(cmd)
    if m:
        cmd = cmd[:m.start()]
    return cmd.replace("$(", ";").replace("`", ";")


def heads(cmd):
    cmd = flatten(cmd)
    for seg in SEPS.split(cmd):
        if "\n" in seg:
            continue
        parts = seg.split()
        while parts and ("=" in parts[0] or parts[0] in PREFIX):
            if parts[0] in PREFIX:
                yield parts[0]          # count the wrapper
            parts = parts[1:]
        if parts and parts[0] == "timeout":
            yield "timeout"
            parts = parts[2:]
        if parts:
            h = parts[0].strip("()[]{}'\"`")
            if h:
                yield h

def get_command_count(path):
    rows = [json.loads(l) for l in open(path, encoding="utf-8")]
    counts = Counter()
    per_row = []
    for row in rows:
        seen = set()
        for cmd in bash_commands(row):
            for h in heads(cmd):
                counts[h] += 1
                seen.add(h)
        if seen:
            per_row.append(len(seen))
    return counts, per_row, rows

def non_sorted_commands(counts, risk):
    known = {c for cmds in risk.values() for c in cmds}
    return {h: n for h, n in counts.items() if h not in known}

def sorted_commands(counts, risk):
    return {
        cat: {c: counts.get(c, 0) for c in cmds}
        for cat, cmds in risk.items()
    }
        
# global options that take a separate argument, e.g. `git -C dir status`
GLOBAL_OPT_ARG = {
    "git": {"-C", "-c", "--git-dir", "--work-tree", "--namespace",
            "--exec-path", "--super-prefix"},
}


def subcommand_of(head, args):
    """First real subcommand in args, skipping global options.
    `git -C dir --no-pager status` -> 'status'. No subcommand -> '(bare)'."""
    skip = GLOBAL_OPT_ARG.get(head, set())
    i = 0
    while i < len(args):
        a = args[i]
        if a in skip:
            i += 2
        elif a.startswith("-"):
            i += 1
        else:
            return a
    return "(bare)"


def subcommand_profile(rows, target):
    prof = Counter()
    for row in rows:
        for cmd in bash_commands(row):
            # same flattening as heads(), so text inside a heredoc body is not
            # counted as a command and nested commands are
            for seg in SEPS.split(flatten(cmd)):
                if "\n" in seg:
                    continue
                parts = seg.split()
                while parts and ("=" in parts[0] or parts[0] in PREFIX):
                    parts = parts[1:]
                if parts and parts[0] == "timeout":
                    parts = parts[2:]
                if parts and parts[0] == target:
                    prof[subcommand_of(target, parts[1:])] += 1
    return prof
